<Window x:Class="Clotch.App.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clotch.App"
        Title="Clotch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        Foreground="#F0EEE6">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2.5" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9C9A93" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8780" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>

        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="#F0EEE6" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="#9C9A93" />
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow inside the transparent window. -->
    <Border x:Name="Root"
            Margin="10,0,10,12"
            Background="#F2161514"
            BorderBrush="#26FFFFFF"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,16,16"
            Padding="14,7,10,8"
            MinWidth="300">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.45" />
        </Border.Effect>

        <DockPanel x:Name="Layout">
            <!-- Compact row (top dock / floating): always visible. Click toggles details, drag moves. -->
            <Grid x:Name="Header" DockPanel.Dock="Top" Background="Transparent" Cursor="Hand" ToolTip="Klik untuk detail, drag untuk memindahkan">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="5j" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ProgressBar Style="{StaticResource Bar}" Width="46" Value="{Binding SessionValue, Mode=OneWay}"
                                 Foreground="{Binding SessionBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SessionPercent}" FontWeight="SemiBold" Margin="6,0,0,0" MinWidth="30" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Mgg" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ProgressBar Style="{StaticResource Bar}" Width="46" Value="{Binding WeeklyValue, Mode=OneWay}"
                                 Foreground="{Binding WeeklyBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding WeeklyPercent}" FontWeight="SemiBold" Margin="6,0,0,0" MinWidth="30" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding SessionReset}" Style="{StaticResource Muted}" VerticalAlignment="Center" />

                <Button x:Name="HideButton" Grid.Column="4" Style="{StaticResource IconButton}" Content="✕" FontSize="10"
                        ToolTip="Sembunyikan notch (tampilkan lagi dari icon tray)" Click="Hide_Click" Margin="6,0,0,0" />
            </Grid>

            <!-- Compact strip (docked to the left/right screen edge). -->
            <StackPanel x:Name="HeaderV" DockPanel.Dock="Left" Visibility="Collapsed" Width="40" VerticalAlignment="Top"
                        Background="Transparent" Cursor="Hand" ToolTip="Klik untuk detail, drag untuk memindahkan">
                <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" HorizontalAlignment="Center" Margin="0,2,0,10" />

                <TextBlock Text="5j" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                <ProgressBar Style="{StaticResource Bar}" Width="46" Value="{Binding SessionValue, Mode=OneWay}"
                             Foreground="{Binding SessionBrush}" HorizontalAlignment="Center" Margin="0,5,0,5">
                    <ProgressBar.LayoutTransform>
                        <RotateTransform Angle="-90" />
                    </ProgressBar.LayoutTransform>
                </ProgressBar>
                <TextBlock Text="{Binding SessionPercent}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" />

                <TextBlock Text="Mgg" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                <ProgressBar Style="{StaticResource Bar}" Width="46" Value="{Binding WeeklyValue, Mode=OneWay}"
                             Foreground="{Binding WeeklyBrush}" HorizontalAlignment="Center" Margin="0,5,0,5">
                    <ProgressBar.LayoutTransform>
                        <RotateTransform Angle="-90" />
                    </ProgressBar.LayoutTransform>
                </ProgressBar>
                <TextBlock Text="{Binding WeeklyPercent}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" />

                <TextBlock Text="{Binding SessionReset}" Style="{StaticResource Muted}" FontSize="10"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8" />

                <Button Style="{StaticResource IconButton}" Content="✕" FontSize="10" HorizontalAlignment="Center"
                        ToolTip="Sembunyikan notch (tampilkan lagi dari icon tray)" Click="Hide_Click" />
            </StackPanel>

            <!-- Expanded details: open below/above the compact row, or beside the strip. Scrolls when taller than the screen. -->
            <ScrollViewer x:Name="DetailsScroll" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
            <!-- Expanded details -->
            <StackPanel x:Name="Details" Width="330" HorizontalAlignment="Left" Margin="0,4,0,0">
                <Rectangle x:Name="SeparatorTop" Height="1" Fill="#1FFFFFFF" Margin="0,6,4,8" />

                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding PlanText}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Margin="0,0,4,0">
                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding NextPollText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="LIMIT" Style="{StaticResource Section}" />
                <ItemsControl ItemsSource="{Binding Limits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LimitRow}">
                            <StackPanel Margin="0,0,4,9">
                                <Grid>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Percent}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Style="{StaticResource Bar}" Value="{Binding Value, Mode=OneWay}" Foreground="{Binding Brush}" Margin="0,4,0,3" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasBreakdown, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="PEMBAGIAN MINGGUAN" Style="{StaticResource Section}" />
                    <ItemsControl ItemsSource="{Binding Breakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ShareRow}">
                                <Grid Margin="0,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Height="4" Value="{Binding Value, Mode=OneWay}"
                                                 Foreground="#D97757" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Percent}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding HasExtraUsage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="EXTRA USAGE" Style="{StaticResource Section}" />
                    <TextBlock Text="{Binding ExtraUsageText}" Style="{StaticResource Muted}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasLocal, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="TOKEN LOKAL · CLAUDE CODE DI MESIN INI" Style="{StaticResource Section}" />
                    <TextBlock Text="{Binding LocalSummary}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding LocalToday}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:TokenRow}">
                                <StackPanel Margin="0,0,4,6">
                                    <Grid>
                                        <TextBlock Text="{Binding Model}" />
                                        <TextBlock Text="{Binding Total}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                    <Button Style="{StaticResource Chip}" Content="Refresh" Click="Refresh_Click" />
                    <Button Style="{StaticResource Chip}" Content="Buka claude.ai" Click="OpenUsage_Click" />
                    <Button Style="{StaticResource Chip}" Content="Sembunyikan" Click="Hide_Click" />
                </StackPanel>
                <TextBlock x:Name="Toast" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <Rectangle x:Name="SeparatorBottom" Height="1" Fill="#1FFFFFFF" Margin="0,8,4,6" Visibility="Collapsed" />
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
